model Notification {
  id             String    @id @default(uuid())
  type           String
  title          String
  body           String?
  link           String?
  entityType     String?
  entityId       String?
  readAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  organizationId String
  recipientId    String
  actorUserId    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    Member       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, recipientId, readAt, createdAt])
  @@index([entityType, entityId])
  @@schema("notification_schema")
}

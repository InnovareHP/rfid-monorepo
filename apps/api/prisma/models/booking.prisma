model BookingPage {
  id                   String   @id @default(uuid())
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  userId               String
  organizationId       String
  slug                 String   @unique
  title                String
  description          String?
  // BOTH lets the invitee choose; the other two fix the mode for every booking.
  locationType         LocationType @default(VIDEO)
  locationLabel        String?
  // Which calendar to write to when both are connected; null means whichever
  // one is, and it decides Meet vs Teams for the meeting link.
  preferredProvider    CalendarProvider?
  durationMinutes      Int      @default(30)
  timezone             String
  bufferBeforeMinutes  Int      @default(0)
  bufferAfterMinutes   Int      @default(0)
  minNoticeHours       Int      @default(4)
  isActive             Boolean  @default(true)

  // Marks this page as a host for the public product demo. The rotation picks
  // the enabled page with the oldest demoLastAssignedAt, so one host means
  // always that host and a second turns round robin on with no code change.
  demoEnabled          Boolean  @default(false)
  demoLastAssignedAt   DateTime? @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability AvailabilityRule[]
  bookings     Booking[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@schema("booking_schema")
}

model AvailabilityRule {
  id            String   @id @default(uuid())
  bookingPageId String
  dayOfWeek     Int
  startMinute   Int
  endMinute     Int

  bookingPage BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)

  @@index([bookingPageId, dayOfWeek])
  @@schema("booking_schema")
}

model Booking {
  id                 String        @id @default(uuid())
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  bookingPageId      String
  organizationId     String
  userId             String
  boardId            String?
  inviteeName        String
  inviteeEmail       String
  inviteeNotes       String?
  // What the invitee actually picked, resolved at booking time so a later
  // change to the page does not rewrite meetings already agreed.
  locationType       BookingLocation @default(VIDEO)
  startTime          DateTime      @db.Timestamptz(3)
  endTime            DateTime      @db.Timestamptz(3)
  status             BookingStatus @default(CONFIRMED)
  calendarProvider   String?
  externalEventId    String?
  calendarSyncFailed Boolean       @default(false)
  // Meet or Teams join URL minted with the calendar event, for VIDEO only.
  meetingUrl         String?
  // The invitee's own zone, captured at booking time, so their confirmation
  // reads in their local time rather than the host's.
  inviteeTimezone    String?
  // Set once the upcoming-meeting reminder goes out, which is what stops the
  // scheduler mailing the same booking on every pass.
  reminderSentAt     DateTime?     @db.Timestamptz(3)

  bookingPage BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  board       Board?      @relation(fields: [boardId], references: [id], onDelete: SetNull)

  // No plain @@unique here: Prisma can't express a partial index. The real
  // constraint — unique (bookingPageId, startTime) among CONFIRMED rows only,
  // so a cancelled slot can be rebooked — lives in a raw-SQL migration as
  // "Booking_bookingPageId_startTime_confirmed_key".
  @@index([bookingPageId, startTime])
  @@index([organizationId])
  @@index([boardId])
  @@index([userId])
  @@schema("booking_schema")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED

  @@schema("booking_schema")
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK

  @@schema("booking_schema")
}

// What a page offers. BOTH is the only value that makes the invitee toggle live.
enum LocationType {
  VIDEO
  IN_PERSON
  BOTH

  @@schema("booking_schema")
}

// What one booking resolved to. No BOTH: a meeting happens one way.
enum BookingLocation {
  VIDEO
  IN_PERSON

  @@schema("booking_schema")
}

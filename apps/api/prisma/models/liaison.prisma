model Marketing {
  id                String           @id @default(uuid())
  facility          String
  touchpoints       TouchpointType[]
  talkedTo          String
  reasonForVisit    String?
  notes             String?
  memberId          String
  organizationId    String
  facilityRecordId  String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime?        @updatedAt @db.Timestamptz(3)
  isDeleted         Boolean          @default(false)

  member         Member       @relation(fields: [memberId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilityRecord Board?       @relation(fields: [facilityRecordId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([organizationId])
  @@index([facilityRecordId])
  @@schema("liason_schema")
}

model Expense {
  id          String @id @default(uuid())
  amount      Float
  description String
  notes       String
  memberId    String

  organizationId String

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  isDeleted Boolean   @default(false)

  imageUrl     String
  member       Member       @relation(fields: [memberId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([organizationId])
  @@schema("liason_schema")
}

model Mileage {
  id String @id @default(uuid())

  destination      String
  countiesMarketed String
  beginningMileage Float
  endingMileage    Float
  totalMiles       Float

  rateType            MileageRateType
  ratePerMile         Float
  reimbursementAmount Float
  isDeleted           Boolean         @default(false)

  memberId String

  organizationId String

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  member       Member       @relation(fields: [memberId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([organizationId])
  @@schema("liason_schema")
}

enum TouchpointType {
  IN_PERSON_MEETING
  LINKED_IN
  FACEBOOK
  TEXT
  EMAIL
  EMAIL_BLAST
  PHONE
  OTHER

  @@schema("liason_schema")
}

enum MileageRateType {
  FEDERAL
  STATE

  @@schema("liason_schema")
}

model Marketing {
  id                String           @id @default(uuid())
  facility          String
  touchpoints       TouchpointType[]
  talkedTo          String
  reasonForVisit    String?
  notes             String?
  memberId          String?
  userId            String?
  organizationId    String
  facilityRecordId  String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime?        @updatedAt @db.Timestamptz(3)
  isDeleted         Boolean          @default(false)

  // The member row disappears when someone leaves the organization, so the
  // log keeps a user id as well: losing the attribution is not acceptable on a
  // financial or activity record, and losing the row itself never is.
  member         Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  user           User?        @relation("MarketingLoggedBy", fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilityRecord Board?       @relation(fields: [facilityRecordId], references: [id], onDelete: SetNull)
  activity       Activity?

  @@index([memberId])
  @@index([userId])
  @@index([organizationId])
  @@index([facilityRecordId])
  @@schema("liason_schema")
}

model Expense {
  id          String @id @default(uuid())
  amount      Float
  description String
  notes       String
  memberId    String?
  userId      String?

  organizationId String

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  isDeleted Boolean   @default(false)

  imageUrl     String
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  user         User?        @relation("ExpenseLoggedBy", fields: [userId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([userId])
  @@index([organizationId])
  @@schema("liason_schema")
}

model Mileage {
  id String @id @default(uuid())

  destination      String
  countiesMarketed String
  beginningMileage Float
  endingMileage    Float
  totalMiles       Float

  rateType            MileageRateType
  ratePerMile         Float
  reimbursementAmount Float
  isDeleted           Boolean         @default(false)

  memberId String?
  userId   String?

  organizationId String

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)

  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  user         User?        @relation("MileageLoggedBy", fields: [userId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([userId])
  @@index([organizationId])
  @@schema("liason_schema")
}

enum TouchpointType {
  IN_PERSON_MEETING
  LINKED_IN
  FACEBOOK
  TEXT
  EMAIL
  EMAIL_BLAST
  PHONE
  OTHER

  @@schema("liason_schema")
}

enum MileageRateType {
  FEDERAL
  STATE

  @@schema("liason_schema")
}

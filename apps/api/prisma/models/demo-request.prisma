model DemoRequest {
  id        String            @id @default(uuid())
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  name      String
  email     String
  company   String
  phone     String?
  message   String?
  status    DemoRequestStatus @default(NEW)

  @@schema("public_schema")
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  SCHEDULED
  CLOSED

  @@schema("public_schema")
}

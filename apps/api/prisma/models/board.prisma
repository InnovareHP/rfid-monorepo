// The record types an organization has. The four seeded isSystem rows replace
// what the ModuleType enum used to express, so a new type costs a row, not a
// migration. Deleting the enum itself is a later phase.
model Module {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  key           String
  label         String
  labelSingular String
  icon          String?
  isSystem      Boolean  @default(false)
  isArchived    Boolean  @default(false)
  moduleOrder   Int      @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fields          Field[]
  records         Board[]
  recipientGroups RecipientGroup[]
  forms           Form[]
  savedReports    SavedReport[]
  customAnalytics CustomAnalytic[]
  analyticDashboards CustomAnalyticDashboard[]

  @@unique([organizationId, key])
  @@index([organizationId, isArchived, moduleOrder])
  @@schema("board_schema")
}

model Field {
  id         String         @id @default(uuid())
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  fieldName  String
  fieldOrder Int
  fieldType  BoardFieldType
  moduleType ModuleType     @default(LEAD)
  moduleId   String?
  isDeleted  Boolean        @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         Module?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  options FieldOption[]
  values  FieldValue[]
  history History[]

  // Soft delete only, so a binned column can be put back with the values its
  // records still hold. Mirrors FieldOption: a user id rather than a member id,
  // because attribution has to outlive the member row.
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?
  deleter   User?     @relation("FieldDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, moduleType, isDeleted, fieldOrder])
  @@index([moduleId, isDeleted, fieldOrder])
  @@index([moduleId, isDeleted, deletedAt])
  @@schema("board_schema")
}

model Board {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)
  recordName String
  // Keyed blind indexes over the normalized recordName: the name itself is
  // encrypted with a random IV, so duplicate detection cannot use it directly.
  // Exact blocks a write; fuzzy only flags a likely duplicate, so it is
  // deliberately not unique.
  recordNameHash      String?
  recordNameFuzzyHash String?
  assignedTo String?
  isDeleted  Boolean    @default(false)
  moduleType ModuleType @default(LEAD)
  moduleId   String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser   User?        @relation(fields: [assignedTo], references: [id])
  module         Module?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  values            FieldValue[]
  history           History[]
  notifications     BoardNotificationState[]
  activities        Activity[]
  relationsAsSource BoardRelation[]          @relation("RelationSource")
  relationsAsTarget BoardRelation[]          @relation("RelationTarget")
  bookings          Booking[]
  formSubmissions   FormSubmission[]
  blastRecipients   BlastRecipient[]
  emailSubscribers  EmailSubscriber[]
  marketingLogs     Marketing[]

  @@index([organizationId, recordName])
  @@index([organizationId, moduleId, recordNameHash])
  @@index([organizationId, moduleId, recordNameFuzzyHash])
  @@index([organizationId, moduleType, isDeleted, createdAt])
  @@index([moduleId, isDeleted, createdAt])
  @@index([assignedTo])
  @@schema("board_schema")
}

model FieldValue {
  id             String  @id @default(uuid())
  recordId       String
  fieldId        String
  value          String?
  organizationId String?

  field        Field                   @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  record       Board                   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  contactValue FieldPersonInformation?
  attachments  FieldValueAttachment[]

  @@unique([recordId, fieldId])
  @@index([recordId])
  @@index([fieldId, value])
  @@index([organizationId])
  @@schema("board_schema")
}

model FieldValueAttachment {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  fileName       String
  fileKey        String
  fileSize       Int
  mimeType       String
  organizationId String
  uploadedBy     String

  fieldValueId String
  fieldValue   FieldValue @relation(fields: [fieldValueId], references: [id], onDelete: Cascade)
  uploader     User       @relation("FieldValueAttachmentUploadedBy", fields: [uploadedBy], references: [id])

  @@index([fieldValueId])
  @@index([organizationId])
  @@schema("board_schema")
}

model FieldOption {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  optionName     String
  color          String?
  isDeleted      Boolean   @default(false)
  optionOrder    Int       @default(0)
  stageType      StageType @default(OPEN)
  probability    Int?
  fieldId        String
  organizationId String?
  field          Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  // Who added it and who binned it. Both are user ids rather than member ids:
  // a member row disappears when someone leaves the organization, and the
  // attribution on an option that is still in the trash has to outlive that.
  // SetNull for the same reason History.createdBy uses it - losing the name is
  // acceptable, losing the option is not.
  createdBy String?
  creator   User?   @relation("FieldOptionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  // Soft delete only, so a binned option can be put back. deletedAt is what
  // orders the trash and what a retention sweep would read.
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?
  deleter   User?     @relation("FieldOptionDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([fieldId])
  @@index([organizationId])
  @@index([fieldId, isDeleted, deletedAt])
  @@schema("board_schema")
}

model History {
  id             String   @id @default(uuid())
  recordId       String
  oldValue       String?
  newValue       String?
  column         String?
  fieldId        String?
  action         String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  createdBy      String?
  organizationId String?

  record Board  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  field  Field? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([fieldId])
  @@schema("board_schema")
}

model FieldPersonInformation {
  id            String @id @default(uuid())
  contactNumber String
  email         String
  address       String

  fieldValueId String @unique

  fieldvalue FieldValue @relation(fields: [fieldValueId], references: [id], onDelete: Cascade)

  @@schema("board_schema")
}

model BoardNotificationState {
  id        String   @id @default(uuid())
  recordId  String   @unique
  lastSeen  DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  record Board @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@schema("board_schema")
}

model BoardCounty {
  id                    String                  @id @default(uuid())
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  countyName            String
  organizationId        String
  boardCountyAssignedTo BoardCountyAssignedTo[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@schema("board_schema")
}

model BoardCountyAssignedTo {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  assignedTo String

  boardCountyId String
  boardCounty   BoardCounty @relation(fields: [boardCountyId], references: [id], onDelete: Cascade)

  @@index([boardCountyId])
  @@schema("board_schema")
}

// Mirrors TouchpointType so a liaison's channel survives the round trip onto
// the board. Without TEXT, LINKED_IN, FACEBOOK and OTHER every one of those
// collapsed to NOTE and the channel was lost. EMAIL_BLAST has no member here on
// purpose: a blast is raised by the marketing feature, never logged by hand.
enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  FAX
  TEXT
  LINKED_IN
  FACEBOOK
  OTHER

  @@schema("board_schema")
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@schema("board_schema")
}

model Activity {
  id             String         @id @default(uuid())
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  title          String
  description    String?
  activityType   ActivityType
  status         ActivityStatus @default(PENDING)
  dueDate        DateTime?      @db.Timestamptz(3)
  completedAt    DateTime?      @db.Timestamptz(3)
  recipientEmail String?
  emailSubject   String?
  emailBody      String?
  emailSentAt    DateTime?      @db.Timestamptz(3)
  senderEmail    String?
  faxNumber      String?
  faxId          String?
  faxSentAt      DateTime?      @db.Timestamptz(3)

  direction     EmailDirection @default(OUTBOUND)
  trackingId    String?        @unique
  threadToken   String?
  messageId     String?
  openCount     Int            @default(0)
  firstOpenedAt DateTime?      @db.Timestamptz(3)
  lastOpenedAt  DateTime?      @db.Timestamptz(3)

  openEvents EmailOpenEvent[]

  recordId String
  record   Board  @relation(fields: [recordId], references: [id], onDelete: Cascade)

  // Set when the activity mirrors a liaison marketing log, so edits and deletes stay in sync.
  marketingId String?    @unique
  marketing   Marketing? @relation(fields: [marketingId], references: [id], onDelete: Cascade)

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([organizationId])
  @@index([dueDate])
  @@index([threadToken])
  @@index([organizationId, messageId])
  @@schema("board_schema")
}

enum EmailDirection {
  OUTBOUND
  INBOUND

  @@schema("board_schema")
}

model EmailOpenEvent {
  id         String   @id @default(uuid())
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  ipHash     String?
  clientType String?

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([organizationId])
  @@schema("board_schema")
}

model EmailIngestAddress {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ingestKey String   @unique

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("board_schema")
}

model GmailToken {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime @db.Timestamptz(3)
  gmailAddress String

  @@schema("board_schema")
}

model OutlookToken {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime @db.Timestamptz(3)
  outlookEmail String

  @@schema("board_schema")
}

model BoardRelation {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  sourceId       String
  targetId       String
  relationType   RelationType @default(REFERRAL_LINK)
  organizationId String?

  source Board @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Board @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId])
  @@index([targetId])
  @@index([organizationId])
  @@schema("board_schema")
}

enum ModuleType {
  LEAD
  REFERRAL
  CONTACT
  COMPANY

  // Every organization-defined module shares this value; the module itself is
  // identified by moduleId, so the legacy column stays truthful without
  // growing a value per custom key.
  CUSTOM

  @@schema("board_schema")
}

enum StageType {
  OPEN
  WON
  LOST

  @@schema("board_schema")
}

enum RelationType {
  REFERRAL_LINK
  FACILITY_LINK
  CONTACT_LINK
  COMPANY_LINK

  @@schema("board_schema")
}

enum BoardFieldType {
  TEXT
  NUMBER
  STATUS
  EMAIL
  PHONE
  DATE
  CHECKBOX
  DROPDOWN
  LOCATION
  TIMELINE
  MULTISELECT
  ASSIGNED_TO
  REFERRAL_LINK
  CONTACT_LINK
  COMPANY_LINK
  PERSON
  ATTACHMENT

  @@schema("board_schema")
}

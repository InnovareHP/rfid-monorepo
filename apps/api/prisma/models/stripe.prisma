model Subscription {
  id                   String    @id @default(uuid())
  plan                 String
  referenceId          String
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?
  status               String?
  periodStart          DateTime? @db.Timestamptz(3)
  periodEnd            DateTime? @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean?
  seats                Int?
  trialStart           DateTime? @db.Timestamptz(3)
  trialEnd             DateTime? @db.Timestamptz(3)
  cancelAt             DateTime? @db.Timestamptz(3)
  canceledAt           DateTime? @db.Timestamptz(3)
  endedAt              DateTime? @db.Timestamptz(3)
  billingInterval      String?
  stripeScheduleId     String?

  @@schema("stripe_schema")
}

// Provider-agnostic webhook dedupe. The unique constraint is the claim: insert
// first and let parallel deliveries race at the database, never find-then-insert.
model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  eventId   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@schema("stripe_schema")
}

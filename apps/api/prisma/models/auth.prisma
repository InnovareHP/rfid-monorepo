model User {
  id               String          @id @default(dbgenerated("gen_random_uuid()"))
  name             String
  email            String          @unique
  emailVerified    Boolean
  image            String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @db.Timestamptz(3)
  banExpires       DateTime?       @db.Timestamptz(3)
  isActive         Boolean         @default(false)
  stripeCustomerId String?
  twoFactorEnabled Boolean?
  isOnboarded      Boolean         @default(false)
  role             String          @default("user")
  banReason        String?
  banned           Boolean         @default(false)
  // Set when the user declines the post-login passkey offer, so it is offered
  // once rather than on every sign-in. Passkeys stay optional either way.
  passkeyPromptWaivedAt DateTime? @db.Timestamptz(3)
  invitations      Invitation[]
  members          Member[]
  accounts         UserAccount[]
  passkeys         Passkey[]
  onboarding       UserOnboarding?
  Board            Board[]
  History          History[]

  SupportTicket             SupportTicket[]             @relation("SupportTicketCreateBy")
  SupportTicketAssignedTo   SupportTicket[]             @relation("SupportTicketAssignedTo")
  SupportLiveChat           SupportLiveChat[]           @relation("SupportLiveChatSender")
  SupportTicketMessage      SupportTicketMessage[]      @relation("SupportTicketMessageSender")
  SupportLiveChatMessage    SupportLiveChatMessage[]    @relation("SupportLiveChatMessageSender")
  SupportLiveChatAttachment SupportLiveChatAttachment[] @relation("SupportLiveChatAttachmentSender")
  SupportHistory            SupportHistory[]            @relation("SupportHistorySender")
  SupportTicketRating       SupportTicketRating[]       @relation("SupportTicketRatingCreatedBy")
  Activity                  Activity[]
  GmailToken                GmailToken?
  OutlookToken              OutlookToken?
  GoogleCalendarToken       GoogleCalendarToken?
  OutlookCalendarToken      OutlookCalendarToken?
  bookingPages              BookingPage[]
  ManualArticle             ManualArticle[]             @relation("ManualArticleCreatedBy")
  TwoFactor                 TwoFactor[]
  createdTasks              Task[]                      @relation("TaskCreatedBy")
  taskAttachments           TaskAttachment[]            @relation("TaskAttachmentUploadedBy")
  taskTimeEntries           TaskTimeEntry[]             @relation("TaskTimeEntryUser")
  taskActivities            TaskActivity[]              @relation("TaskActivityActor")
  notificationsActed        Notification[]              @relation("NotificationActor")
  createdCampaigns          Campaign[]
  createdBlasts             Blast[]
  createdRecipientGroups    RecipientGroup[]
  createdSenderIdentities   SenderIdentity[]           @relation("SenderIdentityCreator")
  senderMailboxes           SenderIdentity[]           @relation("SenderIdentityMailbox")
  createdForms              Form[]
  createdLandingPages       LandingPage[]

  @@schema("auth_schema")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String

  // Written by the better-auth two-factor plugin since 1.6.x.
  verified                Boolean @default(false)
  failedVerificationCount Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth_schema")
}

model UserAccount {
  id                   String    @id @default(dbgenerated("gen_random_uuid()"))
  accountId            String
  providerId           String
  userId               String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                String?
  password             String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @db.Timestamptz(3)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth_schema")
}

model UserOnboarding {
  id           String   @id @default(uuid())
  userId       String   @unique
  hearAbout    String
  howToUse     String
  whatToExpect String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth_schema")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime? @db.Timestamptz(3)
  updatedAt  DateTime? @db.Timestamptz(3)

  @@schema("auth_schema")
}

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  createdAt DateTime @db.Timestamptz(3)
  metadata  String?

  // Billing is org-level: one Stripe customer per organization, never per user.
  stripeCustomerId String? @unique

  // HIPAA mode is one-way: enabling it is a compliance commitment over data
  // captured afterwards, so nothing in the app turns it back off.
  hipaaEnabled  Boolean   @default(false)
  baaAcceptedAt DateTime? @db.Timestamptz(3)
  baaVersion    String?
  retentionDays Int       @default(2555)
  ipAllowlist   String[]  @default([])

  invitations     Invitation[]
  members         Member[]
  agreements      ContractAgreement[]
  Board           Board[]
  Field           Field[]
  BoardCounty     BoardCounty[]
  Activity        Activity[]
  emailOpenEvents EmailOpenEvent[]
  emailIngest     EmailIngestAddress?
  integrations    OrgIntegration[]
  taskProjects    TaskProject[]
  taskLists       TaskList[]
  taskStatuses    TaskStatus[]
  tasks           Task[]
  taskLabels      TaskLabel[]
  taskTimeEntries TaskTimeEntry[]
  campaigns       Campaign[]
  blasts          Blast[]
  recipientGroups  RecipientGroup[]
  senderIdentities SenderIdentity[]
  forms           Form[]
  formSubmissions FormSubmission[]
  blastRecipients BlastRecipient[]
  landingPages    LandingPage[]
  notifications   Notification[]
  expenses        Expense[]
  mileages        Mileage[]
  marketingVisits Marketing[]

  @@schema("auth_schema")
}

model OrgIntegration {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  organizationId String
  provider       String
  apiKey         String
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@schema("auth_schema")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketing      Marketing[]
  mileage        Mileage[]
  expense        Expense[]
  taskAssignees  TaskAssignee[]
  taskWatchers   TaskWatcher[]
  taskComments   TaskComment[]
  notifications  Notification[]

  @@schema("auth_schema")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime     @db.Timestamptz(3)
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("auth_schema")
}

enum AdminAction {
  BAN_USER
  UNBAN_USER
  SET_ROLE
  REMOVE_USER
  IMPERSONATE_USER
  STOP_IMPERSONATE
  SET_PASSWORD
  REVOKE_SESSIONS
  UPDATE_USER
  SET_ENTITLEMENT

  @@schema("auth_schema")
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actorUserId    String?
  actorOrgId     String?
  actorRole      String?
  actorIp        String?
  actorUserAgent String?

  action       String
  resourceType String?
  resourceId   String?

  method     String?
  path       String?
  statusCode Int?
  durationMs Int?
  requestId  String?

  changeHash String?
  metadata   Json?

  @@index([actorUserId, createdAt])
  @@index([actorOrgId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  // The retention purge selects on age alone; every other index leads with a
  // different column.
  @@index([createdAt])
  @@schema("auth_schema")
}

// Append-only and deliberately free of user foreign keys: a cascade from a
// deleted admin used to erase that admin's own history. Names are snapshotted at
// insert so a row still reads after the account is gone.
model AdminActivityLog {
  id           String      @id @default(uuid())
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  adminId      String
  adminName    String
  action       AdminAction
  targetUserId String?
  targetName   String?
  targetOrgId  String?
  details      String?
  ipAddress    String?

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@schema("auth_schema")
}

// Better Auth passkey table plus aaguid, resolved to a device label at read time.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @db.Timestamptz(3)
  aaguid       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth_schema")
}

enum AgreementKind {
  BAA
  SUBSCRIPTION

  @@schema("auth_schema")
}

enum AcceptanceMethod {
  signature
  offline

  @@schema("auth_schema")
}

// One row per signing event, org-level: once the owner signs, the org is
// covered. The executed PDF is stored inline rather than in object storage so
// the bytes never leave the org scope behind a shareable URL.
model ContractAgreement {
  id               String           @id @default(uuid())
  organizationId   String
  kind             AgreementKind    @default(BAA)
  termsVersion     String
  acceptanceMethod AcceptanceMethod @default(signature)

  companyLegalName    String
  companyJurisdiction String
  companyEntityType   String
  companyAddress      String

  signerName   String
  signerTitle  String
  signerEmail  String
  signerUserId String?

  document  Bytes?
  ipAddress String?
  userAgent String?
  note      String?
  signedAt  DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, termsVersion])
  @@schema("auth_schema")
}

DATABASE_URL=""
APP_NAME=""
JWT_SECRET=""
# base64 of 32 random bytes — generate: openssl rand -base64 32
ENCRYPTION_KEY=""
REDIS_URL=""
# AWS — single provider for SES, Bedrock, S3 and Amazon Location. IAM creds need
# ses:SendEmail, bedrock:InvokeModel, s3:GetObject/PutObject/DeleteObject on the
# uploads bucket, and geo-places:Autocomplete/GetPlace/Geocode.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Uploads bucket. Objects under public/ are world readable via bucket policy,
# private/ is only reachable through the presigned redirect at GET /api/image/view.
S3_UPLOADS_BUCKET=""
# Optional CDN origin for public/ objects; defaults to the bucket url.
S3_PUBLIC_BASE_URL=""
SES_FROM_EMAIL=""
BEDROCK_MODEL_ID="amazon.nova-micro-v1:0"
BEDROCK_VISION_MODEL_ID="amazon.nova-lite-v1:0"
# scrubs PHI patterns before sending to Bedrock (defense in depth even with AWS BAA).
# Defaults to true; set "false" only with a signed AWS BAA in a HIPAA-eligible region.
AI_SCRUB_PHI="true"
# Eldon Fax (Scale plan) — key needs faxes:read + faxes:write scopes
ELDONFAX_API_KEY=""
ELDONFAX_BASE_URL="https://api.eldonfax.com"
LOG_LEVEL=""
LOG_SERVICE=""
DEBUG=""
WEBSITE_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
TWILIO_AUTH_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_FROM="test <no-reply@roomey.com>ss"
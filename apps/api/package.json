  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --forceExit",
    "test:int": "jest --config jest.int.config.js --runInBand --forceExit",
    "verify:permissions": "node scripts/verify-permissions.mjs",
    "verify:tenant-scope": "ts-node scripts/verify-tenant-scope.ts",
    "verify:analytics-parity": "ts-node scripts/verify-analytics-parity.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "prisma:generate": "prisma generate --schema=./prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:seed-manual": "ts-node prisma/seed-manual.ts",

---
import { Image } from "astro:assets";
import logo from "../../assets/brand/refidly-logo.png";
import { APP_URL, LEGAL_LINKS, SUPPORT_EMAIL } from "../../config";

const YEAR = new Date().getFullYear();

const PRODUCT_LINKS = [
  { href: "/#features", label: "Features" },
  { href: "/#how-it-works", label: "How It Works" },
  { href: "/security", label: "Security & HIPAA" },
  { href: APP_URL, label: "Sign In" },
];

const COMPANY_LINKS = [
  { href: "/about", label: "About Us" },
  { href: "/#why", label: "Why Refidly" },
  { href: `mailto:${SUPPORT_EMAIL}`, label: "Contact Support" },
  { href: `mailto:${SUPPORT_EMAIL}`, label: "Request a Demo" },
];
---

<footer class="bg-surface-tint">
  <div
    class="site-shell grid gap-10 pt-[41px] pb-10 sm:grid-cols-3 lg:grid-cols-[1.9fr_1fr_1.6fr] lg:gap-0"
  >
    <div>
      <a href="/" class="inline-block" aria-label="Refidly home">
        <Image src={logo} alt="Refidly" width={189} height={60} loading="lazy" />
      </a>
      <p class="mt-4 max-w-[240px] text-xs leading-5 font-medium">
        Refidly is built for healthcare marketing and liaison teams. Track
        facilities, referrals, and field activity in one place.
      </p>
    </div>

    <nav class="flex flex-col gap-2" aria-label="Product links">
      <h3
        class="font-sans text-xs leading-4 font-semibold tracking-wide uppercase text-brand"
      >
        Product
      </h3>
      {
        PRODUCT_LINKS.map((link) => (
          <a
            href={link.href}
            class="w-fit text-[13px] leading-5 transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <nav class="flex flex-col gap-2" aria-label="Company links">
      <h3
        class="font-sans text-xs leading-4 font-semibold tracking-wide uppercase text-brand"
      >
        Company
      </h3>
      {
        COMPANY_LINKS.map((link) => (
          <a
            href={link.href}
            class="w-fit text-[13px] leading-5 transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="bg-background">
    <div
      class="site-shell flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-6 text-xs text-muted-foreground"
    >
      <span>© {YEAR} Refidly. All rights reserved.</span>
      <nav
        class="flex flex-wrap gap-x-5 gap-y-2"
        aria-label="Legal links"
      >
        {
          LEGAL_LINKS.map((link) => (
            <a href={link.href} class="transition-colors hover:text-brand">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

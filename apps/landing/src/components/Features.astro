---
import {
  Card,
  CardContent,
} from "@dashboard/ui/components/card";

const FEATURES = [
  {
    icon: "M3 4h18v4H3zM3 10h18v4H3zM3 16h18v4H3z",
    title: "Master facility list",
    body: "Every facility, company, and contact you work with in one live list — with the exact fields your team needs, not a rigid template.",
  },
  {
    icon: "M9 5l7 7-7 7",
    title: "Referral pipeline tracking",
    body: "Follow each referral from first call through assessment to admitted or referred out. Work it as a table or a board, with the statuses your team defines.",
  },
  {
    icon: "M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z",
    title: "Outreach and campaigns",
    body: "Email blasts and campaigns sent through your own Gmail or Outlook, intake forms and landing pages that feed the pipeline, and fax where a facility still needs it.",
  },
  {
    icon: "M7 3v3M17 3v3M4 9h16M5 6h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z",
    title: "Scheduling and tasks",
    body: "A shared calendar, booking links referral sources can use without an account, and tasks assigned to the liaison who owns the relationship.",
  },
  {
    icon: "M8 7h8M8 12h8M8 17h5M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z",
    title: "Field activity logs",
    body: "Expense, mileage, and marketing visit logs your liaisons actually fill in — tied to facilities, with reports ready when finance asks.",
  },
  {
    icon: "M4 19V9m5.5 10V5m5.5 14v-7m5 7V11",
    title: "Analytics with AI on top",
    body: "Referral trends by county, facility, payor, and liaison, plain-English summaries of what changed, and smart scan that turns a business card into a record.",
  },
];
---

<section id="features" class="py-16 lg:py-24">
  <div class="mx-auto w-full max-w-6xl px-6">
    <div class="reveal mx-auto mb-14 max-w-3xl text-center">
      <h2 class="section-title">The whole referral operation, one dashboard</h2>
      <p class="section-lead mx-auto">
        Purpose-built for healthcare marketing teams — not a generic CRM you
        have to bend into shape.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        FEATURES.map((feature, i) => (
          <Card
            className="reveal gap-0 py-7 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg"
            style={{ transitionDelay: `${(i % 3) * 80}ms` }}
          >
            <CardContent className="px-7">
              <div class="mb-4 grid size-11 place-items-center rounded-xl bg-brand-fade text-brand-strong">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={feature.icon} />
                </svg>
              </div>
              <h3 class="mb-2 text-lg font-bold">{feature.title}</h3>
              <p class="text-sm text-muted-foreground">{feature.body}</p>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </div>
</section>

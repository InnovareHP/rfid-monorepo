---
import {
  LEGAL_ADDRESS_PARTS,
  LEGAL_ENTITY,
  SUPPORT_EMAIL,
} from "../../config";

const base = Astro.site ?? Astro.url;
const origin = new URL(base).origin;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";

const organization = {
  "@type": "Organization",
  "@id": `${origin}/#organization`,
  name: "Refidly",
  legalName: LEGAL_ENTITY,
  url: origin,
  logo: {
    "@type": "ImageObject",
    url: `${origin}/refidly-logo.png`,
    width: 567,
    height: 180,
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: LEGAL_ADDRESS_PARTS.street,
    addressLocality: LEGAL_ADDRESS_PARTS.city,
    addressRegion: LEGAL_ADDRESS_PARTS.region,
    postalCode: LEGAL_ADDRESS_PARTS.postalCode,
    addressCountry: LEGAL_ADDRESS_PARTS.country,
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: SUPPORT_EMAIL,
    areaServed: "US",
  },
};

const website = {
  "@type": "WebSite",
  "@id": `${origin}/#website`,
  url: origin,
  name: "Refidly",
  publisher: { "@id": organization["@id"] },
  inLanguage: "en-US",
};

const softwareApplication = {
  "@type": "SoftwareApplication",
  "@id": `${origin}/#software`,
  name: "Refidly",
  url: origin,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Referral tracking software for healthcare marketing and liaison teams. Master facility list, referral pipeline, field activity logs, outreach campaigns, scheduling, and AI-assisted analytics in one dashboard.",
  screenshot: `${origin}/og-image.png`,
  publisher: { "@id": organization["@id"] },
  featureList: [
    "Master facility list",
    "Referral pipeline tracking",
    "Field activity and expense logs",
    "Outreach campaigns through Gmail or Outlook",
    "Scheduling and tasks",
    "Analytics with AI assistance",
  ],
};

// Slug reads as the page name once hyphens become spaces and words are capitalized.
const breadcrumbName = path
  .slice(1)
  .split("-")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");

const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: origin },
    {
      "@type": "ListItem",
      position: 2,
      name: breadcrumbName,
      item: `${origin}${path}`,
    },
  ],
};

const graph = isHome
  ? [organization, website, softwareApplication]
  : [organization, website, breadcrumbs];
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
/>

---
import { buttonVariants } from "@dashboard/ui/components/button";
import { Image } from "astro:assets";
import countyCoverage from "../../assets/home/visibility-county-coverage.png";
import historyCheck from "../../assets/home/visibility-history-check.png";
import backdrop from "../../assets/home/visibility-backdrop.png";
import { APP_URL } from "../../config";
import VisibilityCard from "./VisibilityCard.astro";
---

<section class="relative overflow-hidden py-16 lg:py-[62px]">
  <Image
    src={backdrop}
    alt=""
    aria-hidden="true"
    widths={[768, 1280, 2000]}
    sizes="100vw"
    quality={80}
    loading="lazy"
    data-parallax="6"
    class="absolute inset-0 -z-10 size-full scale-115 rotate-180 object-cover"
  />

  <div class="site-shell text-brand-foreground">
    <div>
      <h2
        data-split
        class="text-center text-[26px] leading-tight font-semibold sm:text-[34px] lg:text-[45px] lg:leading-[50px]"
      >
        Less chasing. More visibility.
      </h2>
      <p
        data-reveal
        class="mt-4 text-center text-base leading-relaxed sm:text-lg lg:text-xl lg:leading-[30px]"
      >
        Stay on top of your referrals, territories, team activity, and
        reporting—all from one system.
      </p>
    </div>

    <div
      class="mt-10 grid gap-6 lg:mt-[79px] lg:grid-cols-[660fr_389fr] lg:gap-[38px]"
    >
      <div class="h-full" data-reveal>
        <VisibilityCard
          icon="/icons/visibility-alerts.svg"
          title="Nothing falls through."
          body="Notifications when a record changes, full history with restore, and AI nudges when a referral source goes quiet."
          image={historyCheck}
          imageAlt="Record history check with change notifications and an AI powered insight"
        />
      </div>
      <div class="h-full" data-reveal>
        <VisibilityCard
          icon="/icons/visibility-access.svg"
          title="One login, the right access for every role."
          body="Owners see everything, liaisons see their work. Invite your teammates with role-based permissions."
        />
      </div>
    </div>

    <div
      class="mt-6 grid gap-6 lg:mt-[44px] lg:grid-cols-[389fr_660fr] lg:gap-[38px]"
    >
      <div class="h-full" data-reveal>
        <VisibilityCard
          icon="/icons/visibility-reporting.svg"
          title="Reporting takes minutes, not your whole Friday."
          body="Filter by county, payor, status, or date range and export to CSV. Monthly reports stop being a whole afternoon."
        />
      </div>
      <div class="h-full" data-reveal>
        <VisibilityCard
          icon="/icons/visibility-territory.svg"
          title="Every county owned."
          body="Assign counties to liaisons and instantly see which territories are covered — and which are leaking referrals."
          image={countyCoverage}
          imageAlt="Assigning a county to a liaison from the territory coverage view"
        />
      </div>
    </div>

    <div class="mt-10 flex justify-center lg:mt-[44px]" data-reveal>
      <a
        href={APP_URL}
        class={buttonVariants({
          variant: "inverse",
          className: "h-[36px] w-[150px] text-base font-bold",
        })}
      >
        Start Free Trial
      </a>
    </div>
  </div>
</section>

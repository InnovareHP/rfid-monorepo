---
import LegalSection from "../components/legal/LegalSection.astro";
import { EFFECTIVE_DATE, SUPPORT_EMAIL } from "../config";
import LegalLayout from "../layouts/LegalLayout.astro";

const SECTIONS = [
  {
    heading: "The short version",
    body: [
      "Refidly uses cookies only where the product cannot work without them. We do not run advertising cookies, we do not embed third-party trackers on refidly.com, and we do not sell or share information collected through cookies. That is why you are not asked to dismiss a consent banner to read this page.",
    ],
  },
  {
    heading: "What we set and why",
    items: [
      "Session cookies. Set when you sign in to portal.refidly.com. They identify your authenticated session and the organization you are working in, so the application can enforce role-based access and show you the right workspace. They are HTTP-only, marked Secure, and expire on their own after a short period of inactivity or when you sign out.",
      "Security cookies. Short-lived values used to protect sign-in, password reset, and one-time-code flows against cross-site request forgery and replay.",
      "Preference storage. Small values that remember interface choices such as sidebar state, saved table filters, and column layout. These stay on your device and hold no personal information.",
    ],
  },
  {
    heading: "What we do not set",
    body: [
      "No advertising or retargeting pixels. No cross-site behavioral tracking. No social media embeds that phone home from our pages. Our marketing site loads a web font from Google Fonts and nothing else from a third party, and we do not place cookies through it.",
    ],
  },
  {
    heading: "Connected accounts",
    body: [
      "When a user connects a Google or Microsoft account for outreach email, that provider runs its own sign-in flow on its own domain and sets its own cookies under its own policy. Refidly receives only the authorization needed to send on that user's behalf.",
    ],
  },
  {
    heading: "Managing cookies",
    body: [
      "Every major browser lets you view, block, and delete cookies in its privacy settings. Because the cookies we set are strictly necessary, blocking them for our domains will sign you out and prevent the application from working. There is no separate consent toggle to manage here, because there is no optional category to turn off.",
    ],
  },
  {
    heading: "Changes",
    body: [
      "If we ever add analytics or any non-essential cookie, we will update this page before it goes live and, where the law requires it, ask for your consent first rather than assume it.",
    ],
  },
];
---

<LegalLayout
  title="Cookie Policy — Refidly"
  description="Refidly uses strictly necessary cookies only: session, security, and interface preferences. No advertising cookies and no third-party trackers."
  heading="Cookie Policy"
  lead="Which cookies Refidly sets, what each one does, and why there is no consent banner to manage."
  updated={EFFECTIVE_DATE}
>
  {SECTIONS.map((section) => <LegalSection {...section} />)}

  <LegalSection heading="Cookie questions">
    <p class="legal-body">
      Reach the team at <a href={`mailto:${SUPPORT_EMAIL}`} class="legal-link"
        >{SUPPORT_EMAIL}</a
      >. Broader detail on data handling is in the <a
        href="/privacy-policy"
        class="legal-link">Privacy Policy</a
      >.
    </p>
  </LegalSection>
</LegalLayout>
